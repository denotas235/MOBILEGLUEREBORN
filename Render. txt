### extension_checker.cpp
```
Função:
  Verifica disponibilidade de cada extensão
  OpenGL ES no runtime.
  Expõe flags booleanas para todos os outros
  sistemas consultarem antes de usar qualquer
  feature.

Por que existe:
  Sem isso, tentar usar uma extensão não
  disponível crasha imediatamente.

Efeito no jogo:
  Zero crashes por extensão não suportada.
  Cada sistema ativa ou usa fallback sozinho.
```

```cpp
// Flags globais — consultadas por todos os sistemas
namespace Extensions {
    bool PLS             = false; // Pixel Local Storage
    bool FRAMEBUF_FETCH  = false; // Framebuffer Fetch
    bool TESSELLATION    = false; // Tessellation Shader
    bool GEOMETRY_SHADER = false; // Geometry Shader
    bool BUFFER_STORAGE  = false; // Immutable Buffers
    bool DRAW_INDIRECT   = false; // Multi Draw Indirect
    bool ASTC_LDR        = false; // ASTC Compression
    bool ASTC_HDR        = false;
    bool SHADOW_SAMPLERS = false; // PCF Shadows
    bool DISCARD_FB      = false; // Framebuffer Discard
    bool MSAA_EXT        = false; // MSAA Renderbuffer
    bool ANISOTROPIC     = false; // Anisotropic Filter
    bool SHADER_ATOMIC   = false; // Image Atomics
    bool COLOR_FLOAT     = false; // Float Framebuffer
    bool COMPUTE_SHADER  = false; // Compute Shaders

    void detectAll() {
        const char* ext =
            (const char*)glGetString(GL_EXTENSIONS);

        PLS = strstr(ext,
            "GL_EXT_shader_pixel_local_storage");
        FRAMEBUF_FETCH = strstr(ext,
            "GL_EXT_shader_framebuffer_fetch");
        TESSELLATION = strstr(ext,
            "GL_EXT_tessellation_shader");
        GEOMETRY_SHADER = strstr(ext,
            "GL_EXT_geometry_shader");
        BUFFER_STORAGE = strstr(ext,
            "GL_EXT_buffer_storage");
        // ... todos os outros
    }
}
```


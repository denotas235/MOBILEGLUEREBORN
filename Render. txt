### mali_caps.cpp
```
Função:
  Detecta capacidades específicas do Mali-G52.
  Número de cores de shader, tamanho de tile,
  limites de textura, máximo de UBOs, etc.

Efeito no jogo:
  Ajusta automaticamente qualidade baseado
  no hardware real detectado.
  Sem configuração manual necessária.
```

```cpp
struct MaliCapabilities {
    int   maxTextureSize;        // geralmente 8192
    int   maxAnisotropy;         // geralmente 16
    int   maxComputeWorkGroups;
    int   shaderCores;           // Mali-G52 tem 1-2 clusters
    int   tileWidth;             // tile size interno
    int   tileHeight;
    bool  supportsHDR;
    float maxShadowResolution;

    void detect() {
        glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTextureSize);
        glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT,
                    (float*)&maxAnisotropy);
        // auto-configura qualidade baseado nos caps
        maxShadowResolution =
            shaderCores >= 2 ? 2048.0f : 1024.0f;
    }
};
```


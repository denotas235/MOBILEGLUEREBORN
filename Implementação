### Feature — Rio Natural

```java
// worldgen/feature/RiverCarver.java

public class RiverCarver {

    public static void carveRiver(
        StructureWorldAccess world,
        BlockPos origin,
        Random random
    ) {
        // Meandros usando noise de ângulo
        double angle = 0.0;
        BlockPos current = origin;
        int length = 200 + random.nextInt(300);

        for (int i = 0; i < length; i++) {
            // Curva natural
            angle += (random.nextDouble() - 0.5) * 0.3;
            int dx = (int)(Math.cos(angle) * 1.5);
            int dz = (int)(Math.sin(angle) * 1.5);

            current = current.add(dx, 0, dz);

            // Largura variável
            int width = 3 + (int)(Math.sin(i * 0.05) * 2);
            carveRiverSection(world, current, width);
        }
    }

    private static void carveRiverSection(
        StructureWorldAccess world,
        BlockPos center,
        int width
    ) {
        for (int x = -width; x <= width; x++) {
            for (int z = -width; z <= width; z++) {
                if (x * x + z * z <= width * width) {
                    BlockPos pos = center.add(x, 0, z);
                    int surfaceY = world.getTopY(
                        Heightmap.Type.WORLD_SURFACE, pos.getX(), pos.getZ()
                    );

                    // Escava e coloca água
                    for (int y = surfaceY - 3; y <= surfaceY; y++) {
                        world.setBlockState(
                            pos.withY(y),
                            y == surfaceY - 3
                                ? Blocks.GRAVEL.getDefaultState()
                                : Blocks.WATER.getDefaultState(),
                            Block.NOTIFY_ALL
                        );
                    }

                    // Borda com areia/terra
                    if (x * x + z * z > (width - 1) * (width - 1)) {
                        world.setBlockState(
                            pos.withY(surfaceY),
                            random.nextBoolean()
                                ? Blocks.SAND.getDefaultState()
                                : Blocks.GRAVEL.getDefaultState(),
                            Block.NOTIFY_ALL
                        );
                    }
                }
            }
        }
    }
}

## 8. ELIMINAR OVERDRAW

```cpp
// rendering/overdraw_reduction.cpp

// Overdraw = mesmo pixel renderizado múltiplas vezes
// Mali-G52 sofre muito com isso

// TÉCNICA 1: Sort front-to-back para blocos opacos
// GPU descarta fragments automaticamente via Early-Z

void sortChunksFrontToBack(
    std::vector<ChunkData>& chunks,
    glm::vec3 cameraPos
) {
    std::sort(chunks.begin(), chunks.end(),
        [&](const ChunkData& a, const ChunkData& b) {
            float da = glm::distance(
                glm::vec3(a.worldX, a.worldY, a.worldZ), cameraPos
            );
            float db = glm::distance(
                glm::vec3(b.worldX, b.worldY, b.worldZ), cameraPos
            );
            return da < db; // mais próximo primeiro
        }
    );
}

// TÉCNICA 2: Transparência em pass separado
// Blocos opacos: front-to-back (menos overdraw)
// Blocos transparentes: back-to-front (só estes)

void renderSeparatePasses() {
    // Pass 1: Opacos (front-to-back) + Early-Z
    glDisable(GL_BLEND);
    renderOpaqueChunks();

    // Pass 2: Transparentes (back-to-front)
    // Muito menos blocos = overdraw mínimo
    glEnable(GL_BLEND);
    glDepthMask(GL_FALSE);
    renderTransparentChunks();
    glDepthMask(GL_TRUE);
}

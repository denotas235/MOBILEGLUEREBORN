// optimization/BlockBreakMixin.java

@Mixin(ServerPlayerInteractionManager.class)
public class BlockBreakOptimizationMixin {

    // Fila de rebuilds pendentes
    private static final Queue<ChunkPos> REBUILD_QUEUE =
        new ConcurrentLinkedQueue<>();

    @Inject(
        method = "tryBreakBlock",
        at = @At(
            value = "INVOKE",
            target = "Lnet/minecraft/world/chunk/WorldChunk;markDirty()V"
        ),
        cancellable = true
    )
    private void deferChunkRebuild(BlockPos pos, CallbackInfoReturnable<Boolean> cir) {
        // Em vez de rebuild imediato, adiciona na fila
        REBUILD_QUEUE.add(new ChunkPos(pos));
    }

    @Inject(method = "tick", at = @At("TAIL"))
    private void processRebuildQueue(CallbackInfo ci) {
        // Processa máximo 2 rebuilds por tick
        // para não travar o game thread
        int processed = 0;
        while (!REBUILD_QUEUE.isEmpty() && processed < 2) {
            ChunkPos cp = REBUILD_QUEUE.poll();
            scheduleChunkRebuild(cp);
            processed++;
        }
    }
}
```


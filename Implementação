## 2. GREEDY MESHING

### Por que elimina 90% dos vértices

```
VANILLA — cada face de bloco = 4 vértices:
Parede de pedra 16×16:
= 256 blocos × 4 vértices = 1024 vértices

GREEDY MESHING — agrupa faces iguais:
Parede de pedra 16×16:
= 1 quad gigante = 4 vértices

Chunk típico:
Vanilla:      ~50.000 vértices
Greedy:       ~3.000 vértices
= 16x menos vértices
= 16x menos trabalho da GPU
```

```java
// java: optimization/GreedyMesher.java

public class GreedyMesher {

    // Resultado: lista de quads mesclados
    public record MergedQuad(
        int x, int y, int z,
        int width, int height,
        Direction face,
        BlockState block
    ) {}

    public List<MergedQuad> mesh(
        ChunkSection section, Direction face
    ) {
        List<MergedQuad> quads = new ArrayList<>();
        boolean[][] merged = new boolean[16][16];

        // Eixos baseados na face
        int[] u = faceU(face); // eixo horizontal
        int[] v = faceV(face); // eixo vertical
        int[] n = faceN(face); // eixo normal

        for (int layer = 0; layer < 16; layer++) {
            clearMerged(merged);

            for (int j = 0; j < 16; j++) {
                for (int i = 0; i < 16; i++) {
                    if (merged[i][j]) continue;

                    BlockState block = getBlock(
                        section, i, j, layer, face
                    );
                    if (block == null || !isFaceVisible(
                            section, i, j, layer, face)) {
                        continue;
                    }

                    // Expande na direção U (horizontal)
                    int width = 1;
                    while (i + width < 16
                        && !merged[i + width][j]
                        && canMerge(block, getBlock(
                            section, i + width, j, layer, face
                        ))) {
                        width++;
                    }

                    // Expande na direção V (vertical)
                    int height = 1;
                    outer:
                    while (j + height < 16) {
                        for (int k = 0; k < width; k++) {
                            if (merged[i + k][j + height]
                                || !canMerge(block, getBlock(
                                    section, i + k,
                                    j + height, layer, face
                                ))) {
                                break outer;
                            }
                        }
                        height++;
                    }

                    // Marca como processado
                    for (int dv = 0; dv < height; dv++)
                        for (int du = 0; du < width; du++)
                            merged[i + du][j + dv] = true;

                    quads.add(new MergedQuad(
                        i, j, layer,
                        width, height,
                        face, block
                    ));
                }
            }
        }
        return quads;
    }

    private boolean canMerge(BlockState a, BlockState b) {
        if (b == null) return false;
        // Mesmo bloco E mesma textura E sem propriedades especiais
        return a.getBlock() == b.getBlock()
            && !a.hasBlockEntity()
            && !b.hasBlockEntity();
    }
}

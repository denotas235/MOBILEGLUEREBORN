### Módulo 1 — Shader Binary Cache
**Extensões usadas:** `MALI_PROGRAM_BINARY` ✅ `GET_PROGRAM_BINARY` ✅

```cpp
// cache/shader_binary_cache.cpp

#include <GLES3/gl3.h>
#include <android/log.h>
#include <fstream>
#include <string>

#define CACHE_DIR "/data/data/com.movtery.zalithlauncher/cache/shader_bin/"

void saveProgramBinary(GLuint program, const std::string& key) {
    GLint binaryLength = 0;
    glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &binaryLength);
    if (binaryLength == 0) return;

    std::vector<uint8_t> binary(binaryLength);
    GLenum binaryFormat;
    glGetProgramBinary(program, binaryLength, nullptr, &binaryFormat, binary.data());

    std::string path = CACHE_DIR + key + ".bin";
    std::ofstream file(path, std::ios::binary);
    file.write(reinterpret_cast<char*>(&binaryFormat), sizeof(GLenum));
    file.write(reinterpret_cast<char*>(binary.data()), binaryLength);
}

bool loadProgramBinary(GLuint program, const std::string& key) {
    std::string path = CACHE_DIR + key + ".bin";
    std::ifstream file(path, std::ios::binary);
    if (!file.good()) return false;

    GLenum binaryFormat;
    file.read(reinterpret_cast<char*>(&binaryFormat), sizeof(GLenum));

    std::vector<uint8_t> binary(
        (std::istreambuf_iterator<char>(file)),
        std::istreambuf_iterator<char>()
    );

    glProgramBinary(program, binaryFormat, binary.data(), binary.size());

    GLint status = 0;
    glGetProgramiv(program, GL_LINK_STATUS, &status);
    return status == GL_TRUE;
}
```

**Resultado:** Shaders carregam instantaneamente na 2ª sessão.


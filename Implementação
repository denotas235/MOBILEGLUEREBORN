SkyState computeSkyState(float timeOfDay) {

// timeOfDay: 0.0 = meia-noite, 0.5 = meio-dia, 1.0 = meia-noite

    SkyState state;

    if (timeOfDay < 0.25f) {
        // Madrugada → Amanhecer
        float t = timeOfDay / 0.25f;
        state.sunColor      = glm::mix(glm::vec3(0,0,0),
                                       glm::vec3(1.0,0.3,0.05), t);
        state.godrayColor   = glm::vec3(1.0, 0.4, 0.1);
        state.godrayIntensity = 0.8f * t;
        state.sunElevation  = t * 0.3f;

    } else if (timeOfDay < 0.5f) {
        // Manhã → Meio-dia
        float t = (timeOfDay - 0.25f) / 0.25f;
        state.sunColor      = glm::mix(glm::vec3(1.0,0.7,0.3),
                                       glm::vec3(1.0,0.95,0.8), t);
        state.godrayColor   = glm::vec3(1.0, 0.9, 0.7);
        state.godrayIntensity = 0.4f;
        state.sunElevation  = 0.3f + t * 0.7f;

    } else if (timeOfDay < 0.75f) {
        // Meio-dia → Tarde
        float t = (timeOfDay - 0.5f) / 0.25f;
        state.sunColor      = glm::mix(glm::vec3(1.0,0.95,0.8),
                                       glm::vec3(1.0,0.5,0.1), t);
        state.godrayColor   = glm::vec3(1.0, 0.6, 0.2);
        state.godrayIntensity = 0.4f + t * 0.6f;
        state.sunElevation  = 1.0f - t * 0.7f;

    } else {
        // Pôr do sol → Noite
        float t = (timeOfDay - 0.75f) / 0.25f;
        state.sunColor      = glm::mix(glm::vec3(1.0,0.3,0.05),
                                       glm::vec3(0,0,0), t);
        state.godrayColor   = glm::vec3(0.8, 0.2, 0.05);
        state.godrayIntensity = 1.2f * (1.0f - t);
        state.sunElevation  = 0.3f * (1.0f - t);
    }

    return state;
}

## 5. HZB — HIERARQUICAL Z-BUFFER OCCLUSION

### Por que elimina chunks invisíveis

```
Montanha na sua frente:
Vanilla: renderiza chunks atrás da montanha
HZB:     GPU sabe que estão oclusos → pula tudo

Grande construção de pedra:
Vanilla: renderiza interior (você não vê)
HZB:     interior completamente pulado

Resultado: em cidades/estruturas grandes
= 40-60% dos chunks nunca renderizados
```

```cpp
// rendering/hzb_culling.cpp

class HZBCuller {
    GLuint hzbTexture;   // mipmap de depth
    GLuint hzbProgram;   // compute que gera o HZB

public:
    // Gera hierarquia de depth após Early-Z
    void buildHZB(GLuint depthTexture, int w, int h) {
        glBindImageTexture(0, depthTexture, 0,
            GL_FALSE, 0, GL_READ_ONLY, GL_R32F);
        glBindImageTexture(1, hzbTexture, 0,
            GL_FALSE, 0, GL_WRITE_ONLY, GL_R32F);

        glUseProgram(hzbProgram);
        glDispatchCompute(w/8, h/8, 1);
        glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);

        // Gera mipmaps do HZB
        glBindTexture(GL_TEXTURE_2D, hzbTexture);
        glGenerateMipmap(GL_TEXTURE_2D);
    }
};

// Compute shader de culling com HZB
const char* HZB_CULL_COMP = R"(
#version 310 es

layout(local_size_x = 64) in;

struct ChunkData {
    vec4  boundsMin;
    vec4  boundsMax;
    uint  visible;
    uint  drawIndex;
    uint  pad[2];
};

layout(std430, binding = 0) buffer Chunks {
    ChunkData chunks[];
};

layout(std430, binding = 1) buffer DrawCmds {
    uint drawCount;
    uint cmds[];
};

uniform sampler2D u_hzb;
uniform mat4      u_projView;
uniform vec2      u_screenSize;

// Projeta AABB na tela e verifica contra HZB
bool isVisible(vec3 bmin, vec3 bmax) {
    // Projeta 8 cantos do AABB
    vec2 screenMin = vec2(1.0);
    vec2 screenMax = vec2(0.0);
    float minDepth = 1.0;

    for (int i = 0; i < 8; i++) {
        vec3 corner = vec3(
            (i & 1) != 0 ? bmax.x : bmin.x,
            (i & 2) != 0 ? bmax.y : bmin.y,
            (i & 4) != 0 ? bmax.z : bmin.z
        );
        vec4 clip = u_projView * vec4(corner, 1.0);
        clip /= clip.w;

        vec2 ndc = clip.xy * 0.5 + 0.5;
        screenMin = min(screenMin, ndc);
        screenMax = max(screenMax, ndc);
        minDepth  = min(minDepth, clip.z * 0.5 + 0.5);
    }

    // Escolhe mip baseado no tamanho na tela
    vec2 sizePixels = (screenMax - screenMin) * u_screenSize;
    float mip = ceil(log2(max(sizePixels.x, sizePixels.y)));

    // Amostra HZB no mip correspondente
    float hzbDepth = textureLod(
        u_hzb,
        (screenMin + screenMax) * 0.5,
        mip
    ).r;

    // Visível se chunk está na frente do que já existe
    return minDepth <= hzbDepth + 0.001;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= chunks.length()) return;

    ChunkData chunk = chunks[id];

    if (isVisible(chunk.boundsMin.xyz, chunk.boundsMax.xyz)) {
        uint idx = atomicAdd(drawCount, 1u);
        cmds[idx] = id;
        chunks[id].visible = 1u;
    } else {
        chunks[id].visible = 0u;
    }
}
)";

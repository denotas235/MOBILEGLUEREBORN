const char* OCCLUSION_FRAG = R"(
#version 300 es
precision mediump float;

uniform sampler2D u_sceneDepth;
uniform sampler2D u_sceneColor;
uniform vec2      u_sunScreenPos; // posição do sol na tela
uniform vec2      u_screenSize;

out vec4 fragColor;

void main() {
    vec2 uv = gl_FragCoord.xy / (u_screenSize * 0.25); // quarter res

    float depth = texture(u_sceneDepth, uv).r;
    vec3  color = texture(u_sceneColor, uv).rgb;

    // Se não é céu (depth < 1.0), é oclusão
    float occlusion = depth < 0.9999 ? 0.0 : 1.0;

    fragColor = vec4(color * occlusion, 1.0);
}
)";

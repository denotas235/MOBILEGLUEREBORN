### Pass 2 — Radial Blur (godrays)

```cpp
const char* GODRAYS_FRAG = R"(
#version 300 es
precision mediump float;

uniform sampler2D u_occlusionMap;
uniform vec2      u_sunScreenPos;  // [0,1] espaço de tela
uniform float     u_exposure;      // intensidade dos raios
uniform float     u_decay;         // quanto cada sample decai
uniform float     u_density;       // compressão dos raios
uniform float     u_weight;        // peso de cada sample
uniform float     u_time;          // para animação sutil

out vec4 fragColor;

const int NUM_SAMPLES = 64; // samples do radial blur

void main() {
    vec2 uv = gl_FragCoord.xy /
              vec2(textureSize(u_occlusionMap, 0));

    // Direção do pixel para o sol
    vec2 deltaUV = (uv - u_sunScreenPos)
                   * (1.0 / float(NUM_SAMPLES))
                   * u_density;

    vec2 currentUV = uv;
    vec3 accumColor = vec3(0.0);
    float illuminationDecay = 1.0;

    for (int i = 0; i < NUM_SAMPLES; i++) {
        currentUV -= deltaUV;

        vec3 sample = texture(u_occlusionMap, currentUV).rgb;

        // Decai ao longo do raio
        sample *= illuminationDecay * u_weight;
        accumColor += sample;

        illuminationDecay *= u_decay;
    }

    // Cor do sol baseada na hora do dia
    // Manhã/tarde: alaranjado
    // Meio-dia: branco-amarelo
    // Pôr do sol: vermelho-laranja intenso
    vec3 sunColor = mix(
        vec3(1.0, 0.3, 0.05),  // pôr/nascer do sol
        vec3(1.0, 0.95, 0.7),  // meio-dia
        u_sunElevation          // 0.0 = horizonte, 1.0 = topo
    );

    fragColor = vec4(accumColor * u_exposure * sunColor, 1.0);
}
)";

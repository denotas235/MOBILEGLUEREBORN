## 🪞 2. REFLECTIONS (SSR)

```cpp
// rendering/reflections_ssr.cpp

// Screen Space Reflections lendo da PLS
// Usa FRAMEBUFFER_FETCH + PLS juntos

const char* SSR_FRAG = R"(
#version 310 es
#extension GL_EXT_shader_pixel_local_storage  : require
#extension GL_EXT_shader_framebuffer_fetch    : require

precision highp float;

__pixel_localEXT PLSData {
    layout(rgba8)    mediump vec4  albedo;
    layout(rgb10_a2) mediump vec4  normal_roughness;
    layout(r32f)     highp   float depth;
    layout(rgba16f)  mediump vec4  light_accumulator;
    layout(rgb10_a2) mediump vec4  emissive_metallic;
} pls;

// Frame anterior para reflection lookup
uniform sampler2D u_previousFrame;
uniform sampler2D u_depthBuffer;
uniform mat4      u_projView;
uniform mat4      u_invProjView;
uniform vec3      u_cameraPos;
uniform vec2      u_screenSize;

vec3 reconstructPos(vec2 uv, float depth) {
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 world = u_invProjView * clip;
    return world.xyz / world.w;
}

// Ray march no espaço de tela
vec4 traceSSR(
    vec3 worldPos, vec3 reflectDir,
    float roughness
) {
    // Mais rugoso = reflexo mais borrado
    if (roughness > 0.8) return vec4(0.0);

    vec3 rayPos   = worldPos;
    vec3 rayStep  = reflectDir * 0.5; // passo de 0.5 blocos

    int maxSteps = 32; // máximo de steps (performance)
    float stepMult = 1.15; // accelera o ray ao longe

    for (int i = 0; i < maxSteps; i++) {
        rayPos += rayStep;
        rayStep *= stepMult;

        // Projeta posição na tela
        vec4 clipPos = u_projView * vec4(rayPos, 1.0);
        clipPos /= clipPos.w;

        vec2 sampleUV = clipPos.xy * 0.5 + 0.5;

        // Fora da tela — para
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 ||
            sampleUV.y < 0.0 || sampleUV.y > 1.0) {
            break;
        }

        float sampledDepth = texture(u_depthBuffer, sampleUV).r;
        float rayDepth = clipPos.z * 0.5 + 0.5;

        // Acertou uma superfície
        if (rayDepth > sampledDepth + 0.001) {
            // Fade nas bordas da tela
            vec2 edgeFade = smoothstep(
                vec2(0.0), vec2(0.1), sampleUV
            ) * smoothstep(
                vec2(1.0), vec2(0.9), sampleUV
            );
            float fade = edgeFade.x * edgeFade.y;

            // Blur baseado em roughness
            vec4 reflection;
            if (roughness < 0.1) {
                // Quase espelho
                reflection = texture(u_previousFrame, sampleUV);
            } else {
                // Borrado — amostra vizinhos
                float blurSize = roughness * 0.02;
                reflection = vec4(0.0);
                reflection += texture(u_previousFrame, sampleUV + vec2( blurSize, 0.0)) * 0.25;
                reflection += texture(u_previousFrame, sampleUV + vec2(-blurSize, 0.0)) * 0.25;
                reflection += texture(u_previousFrame, sampleUV + vec2(0.0,  blurSize)) * 0.25;
                reflection += texture(u_previousFrame, sampleUV + vec2(0.0, -blurSize)) * 0.25;
            }

            return vec4(reflection.rgb, fade);
        }
    }

    return vec4(0.0); // sem hit = sem reflexo
}

void main() {
    vec4  albedo     = pls.albedo;
    vec4  normalRgh  = pls.normal_roughness;
    float depth      = pls.depth;
    float metallic   = pls.emissive_metallic.a;
    float roughness  = normalRgh.w;

    // Só calcula reflexo para superfícies que valem
    // água: roughness ~0.0, metallic ~0.0
    // metal polido: roughness ~0.1, metallic ~1.0
    bool shouldReflect = roughness < 0.6 ||
                         metallic  > 0.3;

    if (!shouldReflect) return;

    vec2  uv       = gl_FragCoord.xy / u_screenSize;
    vec3  worldPos = reconstructPos(uv, depth);
    vec3  normal   = normalRgh.xyz * 2.0 - 1.0;
    vec3  viewDir  = normalize(worldPos - u_cameraPos);
    vec3  reflDir  = reflect(viewDir, normal);

    // Fresnel — mais reflexo em ângulo rasante
    float fresnel = pow(1.0 - max(dot(-viewDir, normal), 0.0), 3.0);
    fresnel = mix(0.04, 1.0, fresnel); // F0 para dieletrico

    vec4 ssrResult = traceSSR(worldPos, reflDir, roughness);

    if (ssrResult.a > 0.0) {
        float reflStrength = fresnel
                           * ssrResult.a
                           * (1.0 - roughness)
                           * mix(0.3, 1.0, metallic);

        pls.light_accumulator.rgb = mix(
            pls.light_accumulator.rgb,
            ssrResult.rgb * albedo.rgb,
            reflStrength
        );
    }
}
)";
```


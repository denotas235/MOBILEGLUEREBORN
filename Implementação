### Pass 3 — Sunlight Atmosférico (Rayleigh Scattering)

```cpp
// Céu físico — dispersão de Rayleigh
// Por que o céu é azul, pôr do sol é laranja

const char* SKY_FRAG = R"(
#version 310 es
precision highp float;

uniform vec3  u_sunDirection;  // direção do sol normalizada
uniform vec3  u_cameraPos;
uniform float u_time;

out vec4 fragColor;

// Coeficientes de Rayleigh para RGB
// Azul dispersa muito mais que vermelho
const vec3 RAYLEIGH_COEFF = vec3(5.5e-6, 13.0e-6, 22.4e-6);
const vec3 MIE_COEFF      = vec3(21e-6);
const float MIE_DIRECTIONALITY = 0.758;
const float ATMOSPHERE_RADIUS = 6420e3;
const float PLANET_RADIUS     = 6360e3;

float rayleighPhase(float cosTheta) {
    return (3.0 / (16.0 * 3.14159)) * (1.0 + cosTheta * cosTheta);
}

float miePhase(float cosTheta, float g) {
    float g2 = g * g;
    return (3.0 / (8.0 * 3.14159))
         * ((1.0 - g2) * (1.0 + cosTheta * cosTheta))
         / ((2.0 + g2) * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

vec3 computeSkyColor(vec3 rayDir, vec3 sunDir) {
    float cosTheta = dot(rayDir, sunDir);

    // Quantidade de atmosfera atravessada
    float atmosphereDepth = sqrt(
        ATMOSPHERE_RADIUS * ATMOSPHERE_RADIUS
        - PLANET_RADIUS * PLANET_RADIUS
            * (1.0 - dot(rayDir, vec3(0,1,0)) * dot(rayDir, vec3(0,1,0)))
    );

    // Rayleigh — céu azul
    vec3 rayleigh = RAYLEIGH_COEFF
                  * rayleighPhase(cosTheta)
                  * atmosphereDepth;

    // Mie — halo solar
    vec3 mie = MIE_COEFF
             * miePhase(cosTheta, MIE_DIRECTIONALITY)
             * atmosphereDepth;

    // Combina
    vec3 extinction = exp(-(RAYLEIGH_COEFF + MIE_COEFF)
                          * atmosphereDepth);
    vec3 inScatter  = (rayleigh + mie) * extinction;

    return inScatter * 20.0; // escala para range visível
}

void main() {
    vec2 uv  = gl_FragCoord.xy / vec2(1920.0, 1080.0);
    vec3 ray = normalize(/* direção do pixel */vec3(uv * 2.0 - 1.0, -1.0));

    vec3 skyColor = computeSkyColor(ray, u_sunDirection);

    // HDR tonemapping simples
    skyColor = skyColor / (skyColor + vec3(1.0));

    fragColor = vec4(skyColor, 1.0);
}
)";
```

### Pass 4 — Composição Final

```cpp
const char* COMPOSITE_FRAG = R"(
#version 310 es
#extension GL_EXT_shader_pixel_local_storage : require

precision highp float;

__pixel_localEXT PLSData {
    layout(rgba8)    mediump vec4  albedo;
    layout(rgb10_a2) mediump vec4  normal_roughness;
    layout(r32f)     highp   float depth;
    layout(rgba16f)  mediump vec4  light_accumulator;
    layout(rgb10_a2) mediump vec4  emissive_metallic;
} pls;

uniform sampler2D u_godrays;
uniform sampler2D u_skybox;
uniform sampler2D u_bloom;
uniform vec2      u_screenSize;

// ACES Tonemapping — padrão cinema
vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

// Correção gamma sRGB
vec3 linearToSRGB(vec3 color) {
    return pow(color, vec3(1.0 / 2.2));
}

void main() {
    vec2 uv = gl_FragCoord.xy / u_screenSize;

    // Lê resultado acumulado da PLS
    vec3 litScene = pls.light_accumulator.rgb;

    // Adiciona godrays
    vec3 godrays  = texture(u_godrays, uv).rgb;
    litScene += godrays * 0.15; // sutil mas visível

    // Adiciona bloom
    vec3 bloom    = texture(u_bloom, uv).rgb;
    litScene += bloom * 0.08;

    // Ajuste de exposição baseado na hora do dia
    // (auto-exposure simulado)
    float lum = dot(litScene, vec3(0.2126, 0.7152, 0.0722));
    float exposure = 0.5 / (lum + 0.001);
    exposure = clamp(exposure, 0.3, 3.0);
    litScene *= exposure;

    // ACES tonemap → visual cinematográfico
    vec3 tonemapped = ACESFilm(litScene);

    // sRGB output
    vec3 final = linearToSRGB(tonemapped);

    // Escreve output final
    pls.light_accumulator = vec4(final, 1.0);
}
)";

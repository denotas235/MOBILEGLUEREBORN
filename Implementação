### Pass 1 — Geometry Pass (preenche PLS)

```cpp
// Vertex shader
const char* GEOM_VERT = R"(
#version 310 es

layout(location = 0) in vec3 a_pos;
layout(location = 1) in vec3 a_normal;
layout(location = 2) in vec2 a_uv;
layout(location = 3) in vec4 a_color; // vertex color do bloco

uniform mat4 u_mvp;
uniform mat4 u_model;
uniform mat4 u_normalMatrix;

out vec3 v_worldPos;
out vec3 v_normal;
out vec2 v_uv;
out vec4 v_color;

void main() {
    v_worldPos = (u_model * vec4(a_pos, 1.0)).xyz;
    v_normal   = normalize((u_normalMatrix * vec4(a_normal, 0.0)).xyz);
    v_uv       = a_uv;
    v_color    = a_color;
    gl_Position = u_mvp * vec4(a_pos, 1.0);
}
)";

// Fragment shader — escreve na PLS
const char* GEOM_FRAG = R"(
#version 310 es
#extension GL_EXT_shader_pixel_local_storage : require

precision highp float;

__pixel_localEXT PLSData {
    layout(rgba8)    mediump vec4  albedo;
    layout(rgb10_a2) mediump vec4  normal_roughness;
    layout(r32f)     highp   float depth;
    layout(rgba16f)  mediump vec4  light_accumulator;
    layout(rgb10_a2) mediump vec4  emissive_metallic;
} pls;

uniform sampler2D u_blockTexture;
uniform sampler2D u_emissiveMap;  // mapa de blocos emissivos
uniform float     u_roughness;
uniform float     u_metallic;

in vec3 v_worldPos;
in vec3 v_normal;
in vec2 v_uv;
in vec4 v_color;

void main() {
    vec4 texColor = texture(u_blockTexture, v_uv) * v_color;
    vec3 emissive = texture(u_emissiveMap, v_uv).rgb;

    // Empacota normal em [0,1]
    vec3 packedNormal = v_normal * 0.5 + 0.5;

    // Escreve G-Buffer na tile memory
    pls.albedo             = texColor;
    pls.normal_roughness   = vec4(packedNormal, u_roughness);
    pls.depth              = gl_FragCoord.z;
    pls.light_accumulator  = vec4(0.0); // zerado, será preenchido
    pls.emissive_metallic  = vec4(emissive, u_metallic);
}
)";
```


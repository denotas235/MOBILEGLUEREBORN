### Mixin 1 — Terreno com Domain Warp

```java
// mixin/NoiseChunkGeneratorMixin.java

@Mixin(NoiseChunkGenerator.class)
public class NoiseChunkGeneratorMixin {

    @Inject(
        method = "populateNoise",
        at = @At("HEAD"),
        cancellable = true
    )
    private void overrideNoise(
        Blender blender,
        StructureAccessor structureAccessor,
        Chunk chunk,
        int minCellY, int cellCountY,
        CallbackInfoReturnable<CompletableFuture<Chunk>> cir
    ) {
        ChunkPos pos = chunk.getPos();
        applyDomainWarpTerrain(chunk, pos);
    }

    private void applyDomainWarpTerrain(Chunk chunk, ChunkPos pos) {
        for (int x = 0; x < 16; x++) {
            for (int z = 0; z < 16; z++) {
                double worldX = pos.getStartX() + x;
                double worldZ = pos.getStartZ() + z;

                // Domain warp — distorce as coordenadas antes do noise
                double warpX = worldX + 64.0 * fbm(worldX * 0.003, worldZ * 0.003, 3);
                double warpZ = worldZ + 64.0 * fbm(worldX * 0.003 + 5.2, worldZ * 0.003 + 1.3, 3);

                double height = getTerrainHeight(warpX, warpZ);

                // Preenche colunas
                for (int y = chunk.getBottomY(); y < (int) height; y++) {
                    BlockPos bp = new BlockPos(
                        pos.getStartX() + x, y, pos.getStartZ() + z
                    );
                    if (y < height - 4) {
                        chunk.setBlockState(bp, Blocks.STONE.getDefaultState(), false);
                    } else {
                        chunk.setBlockState(bp, Blocks.DIRT.getDefaultState(), false);
                    }
                }
            }
        }
    }

    // FBM — Fractal Brownian Motion para terreno natural
    private double fbm(double x, double z, int octaves) {
        double value = 0.0;
        double amplitude = 0.5;
        double frequency = 1.0;
        for (int i = 0; i < octaves; i++) {
            value += amplitude * simplexNoise(x * frequency, z * frequency);
            amplitude *= 0.5;
            frequency *= 2.0;
        }
        return value;
    }

    private double getTerrainHeight(double x, double z) {
        // Camadas de detalhe
        double continent  = fbm(x * 0.0008, z * 0.0008, 4) * 80.0;
        double mountain   = fbm(x * 0.003,  z * 0.003,  6) * 120.0;
        double detail     = fbm(x * 0.015,  z * 0.015,  3) * 15.0;

        // Mistura baseada em bioma
        double mountainMask = smoothstep(0.3, 0.7, fbm(x * 0.001, z * 0.001, 2));

        return 64.0
             + continent
             + mountain * mountainMask
             + detail;
    }

    private double smoothstep(double edge0, double edge1, double x) {
        double t = Math.max(0.0, Math.min(1.0, (x - edge0) / (edge1 - edge0)));
        return t * t * (3.0 - 2.0 * t);
    }
}
```


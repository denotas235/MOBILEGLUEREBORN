### Módulo 7 — Bloom via Pixel Local Storage
**Extensões usadas:** `PIXEL_LOCAL_STORAGE` ✅ `COLOR_BUFFER_FLOAT` ✅

```cpp
// rendering/bloom_pls.cpp

const char* BLOOM_FRAG = R"(
#version 300 es
#extension GL_EXT_shader_pixel_local_storage : require

precision mediump float;

__pixel_localEXT FragData {
    layout(rgba8) mediump vec4 color;
    layout(r32f)  highp   float depth;
    layout(rgba8) mediump vec4 bloom;
} pls;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    vec4 base = pls.color;
    float lum = luminance(base.rgb);

    // Extrai bright areas para bloom
    float threshold = 0.8;
    float brightness = max(lum - threshold, 0.0);
    pls.bloom = vec4(base.rgb * brightness, 1.0);
}
)";
```


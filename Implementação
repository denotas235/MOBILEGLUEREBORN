Voando com elytra a 30+ blocos/segundo:
- Novos chunks entram no FOV muito rápido
- Culling de entidades torna-se ineficiente
- Atualização de física do player acelerada
- Chunks carregam mais rápido que geram
- LOD (nível de detalhe) muda constantemente
- Skybox e atmosfera re-renderizados a cada frame
```

### Solução Java — Elytra Chunk Predictor

```java
// optimization/ElytraChunkPredictorMixin.java

@Mixin(PlayerEntity.class)
public class ElytraOptimizationMixin {

    private Vec3d lastVelocity = Vec3d.ZERO;
    private boolean wasFlying = false;

    @Inject(method = "tick", at = @At("TAIL"))
    private void predictAndPreloadChunks(CallbackInfo ci) {
        PlayerEntity self = (PlayerEntity)(Object)this;

        boolean isFlying = self.isFallFlying(); // elytra ativa

        if (!isFlying) {
            wasFlying = false;
            return;
        }

        Vec3d vel = self.getVelocity();
        Vec3d pos = self.getPos();

        // Prevê posição em 3 segundos
        // (tempo para gerar chunk a essa velocidade)
        double speed = vel.length();
        Vec3d futurePos = pos.add(vel.multiply(60)); // 3s × 20tps

        // Força geração dos chunks no caminho
        int futureChunkX = (int)(futurePos.x) >> 4;
        int futureChunkZ = (int)(futurePos.z) >> 4;

        ServerWorld world = (ServerWorld) self.getWorld();

        // Pré-carrega cone de chunks à frente
        for (int dx = -3; dx <= 3; dx++) {
            for (int dz = -3; dz <= 3; dz++) {
                world.getChunk(
                    futureChunkX + dx,
                    futureChunkZ + dz
                );
            }
        }

        lastVelocity = vel;
        wasFlying = true;
    }
}
```

### Solução C++ — LOD Dinâmico para Elytra

```cpp
// rendering/dynamic_lod.cpp

struct PlayerState {
    float speed;
    bool  isElytra;
    float altitude;
};

int computeChunkLOD(float distanceFromPlayer, PlayerState state) {
    // LOD base por distância
    int baseLOD;
    if (distanceFromPlayer < 64.0f)       baseLOD = 0; // full detail
    else if (distanceFromPlayer < 128.0f) baseLOD = 1; // half
    else if (distanceFromPlayer < 256.0f) baseLOD = 2; // quarter
    else                                  baseLOD = 3; // minimal

    // Elytra: aumenta LOD de chunks laterais
    // (você não olha para os lados voando)
    if (state.isElytra && state.speed > 20.0f) {
        baseLOD += 1;
    }

    // Altitude alta: chunks abaixo reduzem detalhe
    if (state.altitude > 150.0f) {
        baseLOD += 1;
    }

    return std::min(baseLOD, 3);
}

// Shader de chunk com LOD
const char* CHUNK_LOD_VERT = R"(
#version 300 es

uniform int u_lod;

void main() {
    // LOD 0: todos os vértices
    // LOD 1: pula 1 de cada 2
    // LOD 2: pula 3 de cada 4
    // LOD 3: só silhueta

    if (u_lod > 0 && (gl_VertexID % (1 << u_lod)) != 0) {
        gl_Position = vec4(2.0); // descarta vértice
        return;
    }
    // renderiza normal
}
)";
```

**Efeito no jogo:**
```
Antes:
- Elytra a alta velocidade = chunks brancos/invisíveis
- Stutters a cada novo chunk carregado
- FPS cai de 60 para 20 voando

Depois:
- Chunks pré-carregados antes de você chegar
- LOD reduz detalhe do que você mal vê voando
- FPS estável mesmo a 40+ blocos/segundo
- Altitude alta = chunks distantes mais simples
```


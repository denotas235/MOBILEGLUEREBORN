### Módulo 5 — Water Tessellation
**Extensões usadas:** `TESSELLATION_SHADER` ✅ `GPU_SHADER5` ✅

```cpp
// rendering/water_tessellation.cpp

const char* WATER_TESC = R"(
#version 310 es
#extension GL_EXT_tessellation_shader : require

layout(vertices = 4) out;

uniform float u_tessLevel;  // dinâmico baseado na distância

void main() {
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;

    float dist = length(gl_in[gl_InvocationID].gl_Position.xyz);
    float level = max(1.0, u_tessLevel - dist * 0.1);

    gl_TessLevelOuter[0] = level;
    gl_TessLevelOuter[1] = level;
    gl_TessLevelOuter[2] = level;
    gl_TessLevelOuter[3] = level;
    gl_TessLevelInner[0] = level;
    gl_TessLevelInner[1] = level;
}
)";

const char* WATER_TESE = R"(
#version 310 es
#extension GL_EXT_tessellation_shader : require

layout(quads, equal_spacing, ccw) in;

uniform float u_time;

float wave(vec2 pos, float freq, float amp, float speed) {
    return amp * sin(pos.x * freq + u_time * speed)
               * cos(pos.y * freq + u_time * speed * 0.7);
}

void main() {
    vec4 pos = mix(
        mix(gl_in[0].gl_Position, gl_in[1].gl_Position, gl_TessCoord.x),
        mix(gl_in[3].gl_Position, gl_in[2].gl_Position, gl_TessCoord.x),
        gl_TessCoord.y
    );

    // Ondas multicamada
    pos.y += wave(pos.xz, 2.0, 0.05, 1.2);
    pos.y += wave(pos.xz, 5.0, 0.02, 2.1);
    pos.y += wave(pos.xz, 11.0, 0.008, 3.7);

    gl_Position = u_projView * pos;
}
)";

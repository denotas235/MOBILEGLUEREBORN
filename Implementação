### Feature — Caminho Natural

```java
// worldgen/feature/PathGenerator.java

public class PathGenerator {

    public static void generatePath(
        StructureWorldAccess world,
        BlockPos start,
        BlockPos end,
        Random random
    ) {
        // A* simplificado com ruído para parecer orgânico
        List<BlockPos> points = interpolatePath(start, end, random);

        for (BlockPos point : points) {
            int width = 1 + random.nextInt(2);
            placePath(world, point, width, random);
        }
    }

    private static void placePath(
        StructureWorldAccess world,
        BlockPos center,
        int width,
        Random random
    ) {
        for (int x = -width; x <= width; x++) {
            for (int z = -width; z <= width; z++) {
                BlockPos pos = center.add(x, 0, z);
                int y = world.getTopY(
                    Heightmap.Type.WORLD_SURFACE,
                    pos.getX(), pos.getZ()
                ) - 1;

                BlockPos surface = pos.withY(y);
                BlockState current = world.getBlockState(surface);

                // Só coloca em grama/terra
                if (current.isOf(Blocks.GRASS_BLOCK)
                    || current.isOf(Blocks.DIRT)) {
                    world.setBlockState(
                        surface,
                        Blocks.DIRT_PATH.getDefaultState(),
                        Block.NOTIFY_ALL
                    );
                }
            }
        }
    }

    private static List<BlockPos> interpolatePath(
        BlockPos start, BlockPos end, Random random
    ) {
        List<BlockPos> path = new ArrayList<>();
        int steps = (int) Math.sqrt(
            start.getSquaredDistance(end)
        );

        for (int i = 0; i <= steps; i++) {
            float t = (float) i / steps;
            // Adiciona desvio orgânico
            double noise = (random.nextDouble() - 0.5) * 8.0 * Math.sin(t * Math.PI);
            int x = (int)(start.getX() + (end.getX() - start.getX()) * t + noise);
            int z = (int)(start.getZ() + (end.getZ() - start.getZ()) * t + noise);
            path.add(new BlockPos(x, 0, z));
        }
        return path;
    }
}
```


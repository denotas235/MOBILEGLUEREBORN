### Pass 2 — Colored Light Accumulation

```cpp
// Fragment shader de luz colorida
// Executado UMA VEZ POR FONTE DE LUZ
// Lê e escreve na PLS — sem render target extra

const char* COLORED_LIGHT_FRAG = R"(
#version 310 es
#extension GL_EXT_shader_pixel_local_storage : require
#extension GL_KHR_blend_equation_advanced : require

precision highp float;

__pixel_localEXT PLSData {
    layout(rgba8)    mediump vec4  albedo;
    layout(rgb10_a2) mediump vec4  normal_roughness;
    layout(r32f)     highp   float depth;
    layout(rgba16f)  mediump vec4  light_accumulator;
    layout(rgb10_a2) mediump vec4  emissive_metallic;
} pls;

// Dados da fonte de luz atual
uniform vec3  u_lightPos;      // posição world
uniform vec3  u_lightColor;    // ex: vec3(1.0, 0.4, 0.1) = tocha laranja
uniform float u_lightRadius;   // raio de alcance
uniform float u_lightIntensity;
uniform int   u_lightType;     // 0=point, 1=spot, 2=area

// Matriz para reconstruir posição world do depth
uniform mat4  u_invProjView;
uniform vec2  u_screenSize;

// Reconstrói posição world a partir do depth da PLS
vec3 reconstructWorldPos(float depth) {
    vec2 uv = gl_FragCoord.xy / u_screenSize;
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 worldPos = u_invProjView * clipPos;
    return worldPos.xyz / worldPos.w;
}

// Atenuação fisicamente correta
float lightAttenuation(float dist, float radius) {
    float x = min(dist / radius, 1.0);
    // Janela suave — sem corte abrupto
    return (1.0 - x * x) * (1.0 - x * x) / (dist * dist + 0.01);
}

// BRDF simplificado para blocos (Blinn-Phong + roughness)
vec3 computeLighting(
    vec3 albedo, vec3 normal, vec3 worldPos,
    float roughness, float metallic,
    vec3 lightPos, vec3 lightColor, float intensity
) {
    vec3 L = normalize(lightPos - worldPos);
    vec3 N = normal;
    float dist = length(lightPos - worldPos);

    // Difuso
    float NdotL = max(dot(N, L), 0.0);

    // Especular
    vec3 V = normalize(-worldPos); // câmera em origin
    vec3 H = normalize(L + V);
    float NdotH = max(dot(N, H), 0.0);
    float shininess = mix(4.0, 64.0, 1.0 - roughness);
    float spec = pow(NdotH, shininess) * (1.0 - roughness);

    // Mistura metal/dieletrico
    vec3 specColor = mix(vec3(0.04), albedo, metallic);
    vec3 diffColor = albedo * (1.0 - metallic);

    float atten = lightAttenuation(dist, u_lightRadius);

    return (diffColor * NdotL + specColor * spec)
           * lightColor * intensity * atten;
}

void main() {
    // Lê G-Buffer da tile memory
    vec4  albedo           = pls.albedo;
    vec4  normal_roughness = pls.normal_roughness;
    float depth            = pls.depth;
    vec4  emissive_metallic= pls.emissive_metallic;

    // Desempacota
    vec3  normal    = normal_roughness.xyz * 2.0 - 1.0;
    float roughness = normal_roughness.w;
    vec3  emissive  = emissive_metallic.rgb;
    float metallic  = emissive_metallic.a;

    vec3 worldPos = reconstructWorldPos(depth);

    // Calcula contribuição desta luz
    vec3 lighting = computeLighting(
        albedo.rgb, normal, worldPos,
        roughness, metallic,
        u_lightPos, u_lightColor, u_lightIntensity
    );

    // ACUMULA na PLS — soma com luzes anteriores
    pls.light_accumulator.rgb += lighting;
    pls.light_accumulator.rgb += emissive; // blocos emissivos
}
)";
```


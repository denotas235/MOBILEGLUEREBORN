// rendering/astc_pipeline.cpp

// Formatos ASTC confirmados no Mali-G52
struct ASTCFormat {
    GLenum internalFormat;
    const char* name;
};

static const ASTCFormat ASTC_FORMATS[] = {
    { GL_COMPRESSED_RGBA_ASTC_4x4_KHR,   "4x4"  },  // máx qualidade
    { GL_COMPRESSED_RGBA_ASTC_6x6_KHR,   "6x6"  },  // equilíbrio
    { GL_COMPRESSED_RGBA_ASTC_8x8_KHR,   "8x8"  },  // performance
    { GL_COMPRESSED_RGBA_ASTC_12x12_KHR, "12x12"},   // máx compressão
};

// Decode mode RGB9E5 para HDR — confirmado no log
void setASTCDecodeMode(GLuint texture, bool useHDR) {
    GLenum decodeMode = useHDR
        ? GL_RGBA16F                  // HDR decode
        : GL_UNSIGNED_NORMALIZED_EXT; // LDR decode

    glBindTexture(GL_TEXTURE_2D, texture);
    glTexParameteri(GL_TEXTURE_2D,
        GL_TEXTURE_ASTC_DECODE_PRECISION_EXT,
        decodeMode
    );
}

// Anisotropic filtering — confirmado
void setAnisotropicFilter(GLuint texture, float level) {
    // Máximo suportado no Mali-G52: geralmente 16x
    float maxAniso;
    glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &maxAniso);
    float clampedLevel = std::min(level, maxAniso);

    glBindTexture(GL_TEXTURE_2D, texture);
    glTexParameterf(GL_TEXTURE_2D,
        GL_TEXTURE_MAX_ANISOTROPY_EXT,
        clampedLevel
    );
}
```


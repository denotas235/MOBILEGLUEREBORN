## 1. GPU-DRIVEN INDIRECT RENDERING

### Por que é o maior ganho

```
VANILLA:
CPU → para cada chunk:
  glBindVertexArray()     ← 1 call
  glBindTexture()         ← 1 call
  glUniform(chunkPos)     ← 1 call
  glDrawArrays()          ← 1 call
= 4 calls × 200 chunks = 800 calls/frame
= CPU gasta ~8ms só em draw calls

GPU-DRIVEN:
CPU → 1 vez só:
  glMultiDrawArraysIndirect(200 chunks) ← 1 call
= CPU gasta ~0.05ms
= GPU faz tudo sozinha em paralelo
```

```cpp
// rendering/gpu_driven_renderer.cpp

// ════════════════════════════════════════
// ESTRUTURAS
// ════════════════════════════════════════

struct DrawArraysIndirectCommand {
    GLuint count;       // vértices
    GLuint instanceCount;
    GLuint first;       // offset no mega VBO
    GLuint baseInstance;
};

struct ChunkData {
    float  worldX, worldY, worldZ; // posição
    float  pad;
    GLuint vertexOffset;           // onde no megaVBO
    GLuint vertexCount;
    GLuint lod;                    // nível de detalhe
    GLuint visible;                // 0 ou 1 (GPU escreve)
};

// ════════════════════════════════════════
// SETUP — UMA VEZ
// ════════════════════════════════════════

class GPUDrivenRenderer {
    GLuint megaVBO;          // todos chunks, 1 buffer
    GLuint chunkSSBO;        // dados de todos os chunks
    GLuint indirectBuffer;   // comandos de draw
    GLuint drawCountBuffer;  // quantos chunks visíveis
    GLuint cullingProgram;   // compute shader de culling

    static const size_t MEGA_VBO_SIZE   = 128 * 1024 * 1024; // 128MB
    static const int    MAX_CHUNKS      = 2048;

public:
    void init() {
        // MegaVBO — imutável, alocado uma vez
        // GL_EXT_buffer_storage ✅
        glGenBuffers(1, &megaVBO);
        glBindBuffer(GL_ARRAY_BUFFER, megaVBO);
        glBufferStorage(
            GL_ARRAY_BUFFER,
            MEGA_VBO_SIZE,
            nullptr,
            GL_DYNAMIC_STORAGE_BIT | GL_MAP_WRITE_BIT
        );

        // SSBO com dados de todos os chunks
        glGenBuffers(1, &chunkSSBO);
        glBindBuffer(GL_SHADER_STORAGE_BUFFER, chunkSSBO);
        glBufferStorage(
            GL_SHADER_STORAGE_BUFFER,
            MAX_CHUNKS * sizeof(ChunkData),
            nullptr,
            GL_DYNAMIC_STORAGE_BIT
        );

        // Buffer de comandos indirect
        glGenBuffers(1, &indirectBuffer);
        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);
        glBufferStorage(
            GL_DRAW_INDIRECT_BUFFER,
            MAX_CHUNKS * sizeof(DrawArraysIndirectCommand),
            nullptr,
            GL_DYNAMIC_STORAGE_BIT
        );

        // Counter de draws visíveis
        glGenBuffers(1, &drawCountBuffer);
        glBindBuffer(GL_PARAMETER_BUFFER_EXT, drawCountBuffer);
        GLuint zero = 0;
        glBufferStorage(
            GL_PARAMETER_BUFFER_EXT, 4, &zero,
            GL_DYNAMIC_STORAGE_BIT
        );
    }

    // Render completo — 2 calls de GPU total
    void render(int totalChunks) {
        // Call 1: GPU decide quem é visível
        runCullingPass(totalChunks);

        // Call 2: GPU renderiza todos os visíveis
        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);
        glBindBuffer(GL_PARAMETER_BUFFER_EXT, drawCountBuffer);

        // Um único draw call renderiza TUDO
        glMultiDrawArraysIndirectCountEXT(
            GL_TRIANGLES,
            nullptr, // indirect buffer já bound
            0,       // offset no counter buffer
            totalChunks,
            0        // stride
        );
    }
};
```


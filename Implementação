## 7. TEXTURE ATLAS MÁXIMO + BINDLESS

```cpp
// rendering/texture_atlas.cpp
// Usa GL_EXT_texture_storage ✅

class TextureAtlas {
    GLuint atlasTexture;

    // Atlas único: 4096×4096
    // Cabe ~65.536 texturas de bloco (16×16)
    static const int ATLAS_SIZE  = 4096;
    static const int TILE_SIZE   = 16;
    static const int TILES_PER_ROW = ATLAS_SIZE / TILE_SIZE; // 256

public:
    void init() {
        glGenTextures(1, &atlasTexture);
        glBindTexture(GL_TEXTURE_2D, atlasTexture);

        // Aloca imutável com todos os mipmaps
        // GL_EXT_texture_storage ✅
        glTexStorage2D(
            GL_TEXTURE_2D,
            log2(ATLAS_SIZE) + 1, // mipmaps automáticos
            GL_COMPRESSED_RGBA_ASTC_4x4_KHR, // ASTC ✅
            ATLAS_SIZE, ATLAS_SIZE
        );

        // Anisotropic máximo ✅
        float maxAniso;
        glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &maxAniso);
        glTexParameterf(GL_TEXTURE_2D,
            GL_TEXTURE_MAX_ANISOTROPY_EXT, maxAniso);

        glGenerateMipmap(GL_TEXTURE_2D);
    }

    // Converte ID de textura para UV no atlas
    glm::vec4 getUV(int textureID) {
        int col = textureID % TILES_PER_ROW;
        int row = textureID / TILES_PER_ROW;
        float tileUV = (float)TILE_SIZE / ATLAS_SIZE;
        return glm::vec4(
            col * tileUV,         // u min
            row * tileUV,         // v min
            (col+1) * tileUV,     // u max
            (row+1) * tileUV      // v max
        );
    }
};

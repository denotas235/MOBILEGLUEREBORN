### Módulo 4 — Sombras com Shadow Samplers

**Extensões usadas:** `SHADOW_SAMPLERS` ✅ `DEPTH_TEXTURE` ✅ `DEPTH_TEXTURE_CUBE_MAP` ✅

```cpp
// rendering/shadow_pipeline.cpp

// Shadow map setup
GLuint createShadowMap(int resolution) {
    GLuint shadowFBO, shadowTex;

    glGenTextures(1, &shadowTex);
    glBindTexture(GL_TEXTURE_2D, shadowTex);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT24,
                 resolution, resolution, 0,
                 GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, nullptr);

    // PCF suave via SHADOW_SAMPLERS
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_FUNC, GL_LEQUAL);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);

    glGenFramebuffers(1, &shadowFBO);
    glBindFramebuffer(GL_FRAMEBUFFER, shadowFBO);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
                           GL_TEXTURE_2D, shadowTex, 0);

    GLenum none = GL_NONE;
    glDrawBuffers(1, &none);

    return shadowFBO;
}

// Shader fragment para sombras suaves (PCF)
const char* SHADOW_FRAG = R"(
#version 300 es
precision highp float;

uniform sampler2DShadow u_shadowMap;
uniform mat4 u_lightSpaceMatrix;

in vec4 v_fragPosLightSpace;

float shadowPCF(vec4 fragPosLS) {
    vec3 projCoords = fragPosLS.xyz / fragPosLS.w;
    projCoords = projCoords * 0.5 + 0.5;

    float shadow = 0.0;
    vec2 texelSize = vec2(1.0 / 1024.0);

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            vec3 sampleCoord = vec3(
                projCoords.xy + vec2(x, y) * texelSize,
                projCoords.z - 0.001
            );
            shadow += texture(u_shadowMap, sampleCoord);
        }
    }
    return shadow / 9.0;
}
)";
```


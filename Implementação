## 🗺️ 3. LAG DE RENDERIZAÇÃO DE CHUNKS

### Por que trava

```
Cada chunk visível por frame:
- Rebuild do VBO (vertex buffer)
- Upload para GPU
- Draw call individual
- Transparência ordenada
- State changes excessivos
Tudo sequencial, bloqueando o render thread
```

### Solução C++ — Chunk Batching + Indirect Draw

```cpp
// rendering/chunk_renderer.cpp
// Usa GL_EXT_draw_buffers_indexed ✅
// Usa GL_EXT_buffer_storage ✅

struct ChunkDrawCall {
    GLuint  baseVertex;
    GLuint  vertexCount;
    int32_t chunkX, chunkY, chunkZ;
};

class ChunkBatchRenderer {
    GLuint indirectBuffer;
    GLuint megaVBO;        // todos os chunks num VBO só
    GLuint chunkUBO;       // posições de todos os chunks

    static const int MAX_CHUNKS = 1024;
    static const int MEGA_VBO_SIZE = 64 * 1024 * 1024; // 64MB

public:
    void init() {
        // VBO imutável — ENORME mas alocado uma vez
        glGenBuffers(1, &megaVBO);
        glBindBuffer(GL_ARRAY_BUFFER, megaVBO);
        glBufferStorage(
            GL_ARRAY_BUFFER,
            MEGA_VBO_SIZE,
            nullptr,
            GL_DYNAMIC_STORAGE_BIT // GL_EXT_buffer_storage ✅
        );

        // Buffer de indirect draw commands
        glGenBuffers(1, &indirectBuffer);
        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);
        glBufferStorage(
            GL_DRAW_INDIRECT_BUFFER,
            MAX_CHUNKS * sizeof(DrawArraysIndirectCommand),
            nullptr,
            GL_DYNAMIC_STORAGE_BIT
        );
    }

    // Um único draw call renderiza TODOS os chunks visíveis
    void renderAllChunks(int visibleCount) {
        glBindBuffer(GL_DRAW_INDIRECT_BUFFER, indirectBuffer);
        glMultiDrawArraysIndirectEXT(
            GL_TRIANGLES,
            nullptr,
            visibleCount,
            sizeof(DrawArraysIndirectCommand)
        );
        // visibleCount chunks → 1 draw call
        // antes: 1 draw call POR chunk
    }
};
```

### Solução C++ — Frustum Culling na GPU

```cpp
// rendering/frustum_culling.cpp
// Usa GL_OES_sample_shading ✅

const char* CULLING_COMP = R"(
#version 310 es

layout(local_size_x = 64) in;

struct ChunkAABB {
    vec3 min;
    vec3 max;
};

layout(std430, binding = 0) readonly  buffer Chunks   { ChunkAABB chunks[]; };
layout(std430, binding = 1) writeonly buffer Visible  { uint visible[];      };
layout(std430, binding = 2) writeonly buffer Count    { uint drawCount;      };

uniform vec4 u_frustumPlanes[6];

bool insideFrustum(ChunkAABB aabb) {
    for (int i = 0; i < 6; i++) {
        vec3 p = vec3(
            u_frustumPlanes[i].x > 0.0 ? aabb.max.x : aabb.min.x,
            u_frustumPlanes[i].y > 0.0 ? aabb.max.y : aabb.min.y,
            u_frustumPlanes[i].z > 0.0 ? aabb.max.z : aabb.min.z
        );
        if (dot(u_frustumPlanes[i].xyz, p) + u_frustumPlanes[i].w < 0.0)
            return false;
    }
    return true;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= chunks.length()) return;

    if (insideFrustum(chunks[id])) {
        uint idx = atomicAdd(drawCount, 1u);
        visible[idx] = id;
    }
}
)";
```


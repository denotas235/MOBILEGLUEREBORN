<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="@color/surface_primary"/>
            <stroke android:width="2dp" android:color="@color/steampunk_bronze"/>
        </shape>
    </item>
    
    <!-- Gear icon on the right -->
    <item android:gravity="end|center_vertical" android:right="8dp">
        <bitmap android:src="@drawable/ic_gear_arrow_indicator" />
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus V Logo - Steampunk Style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle (bronze) -->
    <item>
        <shape android:shape="oval">
            <size android:width="80dp" android:height="80dp" />
            <solid android:color="@color/steampunk_bronze" />
            <stroke 
                android:width="4dp"
                android:color="@color/steampunk_gold" />
        </shape>
    </item>
    
    <!-- Inner circle (dark) -->
    <item>
        <shape android:shape="oval">
            <size android:width="70dp" android:height="70dp" />
            <solid android:color="@color/surface_primary" />
        </shape>
    </item>
    
    <!-- V letter (gold) -->
    <item android:gravity="center">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="40dp"
            android:height="40dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@color/steampunk_gold"
                android:pathData="M21,2 L3,2 L3,7 L12,16 L21,7 Z M12,16 L12,22 L10,20 L14,20 Z" />
        </vector>
    </item>
    
    <!-- Gear teeth effect around the edge -->
    <item>
        <shape android:shape="oval">
            <size android:width="80dp" android:height="80dp" />
            <stroke 
                android:width="2dp"
                android:color="@color/steampunk_bronze_dark"
                android:dashWidth="4dp"
                android:dashGap="2dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <size android:width="72dp" android:height="72dp" />
            <solid android:color="@color/steampunk_bronze" />
            <stroke 
                android:width="4dp"
                android:color="@color/steampunk_gold" />
        </shape>
    </item>
    
    <!-- Inner circle -->
    <item>
        <shape android:shape="oval">
            <size android:width="60dp" android:height="60dp" />
            <solid android:color="@color/background_primary" />
        </shape>
    </item>
    
    <!-- V letter -->
    <item android:gravity="center">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="36dp"
            android:height="36dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@color/steampunk_gold"
                android:pathData="M21,2 L3,2 L3,7 L12,16 L21,7 Z M12,16 L12,22 L10,20 L14,20 Z" />
        </vector>
    </item>
    
    <!-- Gear teeth -->
    <item>
        <shape android:shape="oval">
            <size android:width="72dp" android:height="72dp" />
            <stroke 
                android:width="2dp"
                android:color="@color/steampunk_bronze_dark"
                android:dashWidth="3dp"
                android:dashGap="2dp" />
        </shape>
    </item>
</layer-list>

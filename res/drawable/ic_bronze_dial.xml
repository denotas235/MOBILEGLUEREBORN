<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring (bronze) -->
    <item>
        <shape android:shape="ring"
            android:innerRadius="30dp"
            android:thickness="5dp"
            android:useLevel="false">
            <solid android:color="@color/steampunk_bronze" />
        </shape>
    </item>
    
    <!-- Inner background (dark) -->
    <item>
        <shape android:shape="oval">
            <size android:width="70dp" android:height="70dp" />
            <solid android:color="@color/surface_primary" />
        </shape>
    </item>
    
    <!-- Gear teeth effect (simulated with strokes) -->
    <item>
        <shape android:shape="oval">
            <size android:width="70dp" android:height="70dp" />
            <stroke 
                android:width="2dp"
                android:color="@color/steampunk_bronze_dark"
                android:dashWidth="4dp"
                android:dashGap="2dp" />
        </shape>
    </item>
    
    <!-- Center highlight -->
    <item>
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="@color/steampunk_gold" />
            <stroke 
                android:width="1dp"
                android:color="@color/steampunk_bronze" />
        </shape>
    </item>
</layer-list>

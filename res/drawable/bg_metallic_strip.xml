<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Metallic gradient background -->
    <solid android:color="#3A2E28" />
    
    <!-- Top border (light highlight) -->
    <stroke 
        android:width="1dp"
        android:color="#A98467" />
    
    <!-- Bottom border (darker) -->
    <stroke 
        android:width="1dp"
        android:color="#5A4A42" />
    
    <!-- Corners -->
    <corners android:radius="8dp" />
    
    <!-- Inner shadow effect -->
    <gradient
        android:startColor="#4A3A32"
        android:endColor="#2A221B"
        android:angle="270"
        android:type="linear" />
</shape>
